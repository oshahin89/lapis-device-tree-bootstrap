lapis: Mesa 25.0.7's gallium panfrost (panthor backend) and OSMesa on iOS,
over the kernel's LapisGPU service (tools/mesa/lapis-drm as libdrm).
- src/util/u_endian.h: no <endian.h> on Darwin (as hakios's darwin-sdk.patch,
  MIT, Copyright (c) 2025-2026 the HakiOS authors).
- meson.build: on Darwin with panfrost, dep_libdrm is the lapis-drm stand-in.
- pan_kmod.h, panthor_kmod.c, pan_bo.c: mmap()/munmap() on the device go to
  lapis_drm_mmap()/lapis_drm_munmap() (LapisGPU client memory).
- OSMesa: the panfrost screen when LapisGPU is there (after hakios's
  freedreno-darwin.patch), softpipe otherwise or with OSMESA_SOFTWARE=1.

diff -ruN a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -1716,7 +1716,16 @@
   # dependencies (such as vk-runtime) linking to it
   dep_libdrm = null_dep
 endif
-if dep_libdrm.found()
+with_lapis_drm = host_machine.system() == 'darwin' and with_gallium_panfrost
+if with_lapis_drm
+  # lapis: no DRM on iOS; panthor's requests go to the kernel's LapisGPU
+  # service through a stand-in for libdrm (src/lapis-drm, put there by
+  # tools/mesa/build-mesa-ios.sh of the lapis tree); its library is declared
+  # after the project arguments, just before subdir('src')
+  dep_libdrm = declare_dependency(
+    include_directories : include_directories('src/lapis-drm'),
+  )
+elif dep_libdrm.found()
   pre_args += '-DHAVE_LIBDRM'
   if with_dri_platform == 'drm' and with_dri
     with_gallium_drisw_kms = true
@@ -2313,6 +2322,19 @@
 dir_source_root = meson.project_source_root()
 
 
+if with_lapis_drm
+  _liblapis_drm = static_library(
+    'lapis_drm', 'src/lapis-drm/lapis_drm.c',
+    include_directories : include_directories('include', 'src/lapis-drm'),
+    gnu_symbol_visibility : 'default',
+  )
+  dep_libdrm = declare_dependency(
+    include_directories : include_directories('src/lapis-drm'),
+    link_with : _liblapis_drm,
+    link_args : ['-framework', 'IOKit', '-framework', 'CoreFoundation'],
+  )
+endif
+
 subdir('include')
 subdir('bin')
 subdir('src')
