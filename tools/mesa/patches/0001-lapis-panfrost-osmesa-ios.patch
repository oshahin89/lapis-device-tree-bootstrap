diff -ruN a/src/gallium/targets/osmesa/osmesa_target.c b/src/gallium/targets/osmesa/osmesa_target.c
--- a/src/gallium/targets/osmesa/osmesa_target.c
+++ b/src/gallium/targets/osmesa/osmesa_target.c
@@ -27,6 +27,42 @@
 #include "sw/null/null_sw_winsys.h"
 
 
+#ifdef GALLIUM_PANFROST
+#include "panfrost/pan_public.h"
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+#include <xf86drm.h>
+
+static const driOptionDescription panfrost_options[] = {
+#include "panfrost/driinfo_panfrost.h"
+};
+
+/*
+ * lapis: the GPU, where the kernel has one to drive (LapisGPU, through the
+ * libdrm stand-in src/lapis-drm); NULL: none, or OSMESA_SOFTWARE=1.
+ */
+static struct pipe_screen *
+osmesa_create_gpu_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   int fd;
+
+   if (debug_get_bool_option("OSMESA_SOFTWARE", false))
+      return NULL;
+   fd = lapis_drm_open();
+   if (fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, panfrost_options, ARRAY_SIZE(panfrost_options));
+   driParseConfigFiles(&cache, &info, 0, "panthor", NULL, NULL, NULL, 0, NULL, 0);
+   config.options = &cache;
+   config.options_info = &info;
+   screen = panfrost_create_screen(fd, &config, NULL);
+   return screen ? debug_screen_wrap(screen) : NULL;
+}
+#endif
+
 struct pipe_screen *
 osmesa_create_screen(void);
 
@@ -37,6 +73,12 @@
    struct sw_winsys *winsys;
    struct pipe_screen *screen;
 
+#ifdef GALLIUM_PANFROST
+   screen = osmesa_create_gpu_screen();
+   if (screen)
+      return screen;
+#endif
+
    /* We use a null software winsys since we always just render to ordinary
     * driver resources.
     */
