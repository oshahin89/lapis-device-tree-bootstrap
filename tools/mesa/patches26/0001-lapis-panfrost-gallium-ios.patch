+/*
+ * A shader's own constexpr sampler, as Gallium wants it: after air_run.c's
+ * sampler_from_air in hakios's front end (MIT, Darwin on redwood
+ * contributors), comparison left out. Metal's clamp_to_zero is a wrap mode
+ * reading transparent black: CLAMP_TO_BORDER with a zero border.
+ */
+static struct pipe_sampler_state
+sampler_from_air(const struct air_sampler_state *a)
+{
+   static const unsigned wrap[] = {
+      [AIR_SAMPLER_CLAMP_TO_ZERO] = PIPE_TEX_WRAP_CLAMP_TO_BORDER,
+      [AIR_SAMPLER_CLAMP_TO_EDGE] = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      [AIR_SAMPLER_REPEAT] = PIPE_TEX_WRAP_REPEAT,
+      [AIR_SAMPLER_MIRRORED_REPEAT] = PIPE_TEX_WRAP_MIRROR_REPEAT,
+      [AIR_SAMPLER_CLAMP_TO_BORDER] = PIPE_TEX_WRAP_CLAMP_TO_BORDER,
+   };
+   static const unsigned filt[] = {
+      [AIR_SAMPLER_NEAREST] = PIPE_TEX_FILTER_NEAREST,
+      [AIR_SAMPLER_LINEAR] = PIPE_TEX_FILTER_LINEAR,
+      [AIR_SAMPLER_BICUBIC] = PIPE_TEX_FILTER_LINEAR,
+   };
+   static const unsigned mip[] = {
+      [AIR_SAMPLER_MIP_NONE] = PIPE_TEX_MIPFILTER_NONE,
+      [AIR_SAMPLER_MIP_NEAREST] = PIPE_TEX_MIPFILTER_NEAREST,
+      [AIR_SAMPLER_MIP_LINEAR] = PIPE_TEX_MIPFILTER_LINEAR,
+   };
+   struct pipe_sampler_state st = {
+      .wrap_s = wrap[a->address[0] % ARRAY_SIZE(wrap)],
+      .wrap_t = wrap[a->address[1] % ARRAY_SIZE(wrap)],
+      .wrap_r = wrap[a->address[2] % ARRAY_SIZE(wrap)],
+      .mag_img_filter = filt[a->mag_filter % ARRAY_SIZE(filt)],
+      .min_img_filter = filt[a->min_filter % ARRAY_SIZE(filt)],
+      .min_mip_filter = mip[a->mip_filter % ARRAY_SIZE(mip)],
+      .unnormalized_coords = a->pixel_coord,
+      .max_anisotropy = a->max_anisotropy > 1 ? a->max_anisotropy : 0,
+      .min_lod = _mesa_half_to_float(a->lod_min),
+      .max_lod = _mesa_half_to_float(a->lod_max),
+   };
+   if (a->address[0] == AIR_SAMPLER_CLAMP_TO_BORDER || a->address[1] == AIR_SAMPLER_CLAMP_TO_BORDER ||
+       a->address[2] == AIR_SAMPLER_CLAMP_TO_BORDER) {
+      float v = a->border_color == 2 ? 1.0f : 0.0f;
+      st.border_color.f[0] = st.border_color.f[1] = st.border_color.f[2] = v;
+      st.border_color.f[3] = a->border_color == 0 ? 0.0f : 1.0f;
+   }
+   return st;
+}
+
+/* MTLSamplerDescriptor's state */
+PUBLIC void *lapis_gpu_sampler_new(struct lapis_gpu *gpu, const struct lapis_gpu_sampler_desc *d);
+PUBLIC void lapis_gpu_sampler_free(struct lapis_gpu *gpu, void *sampler);
+
+PUBLIC void *
+lapis_gpu_sampler_new(struct lapis_gpu *gpu, const struct lapis_gpu_sampler_desc *d)
+{
+   /* MTLSamplerAddressMode: clamp to edge, mirror clamp to edge, repeat,
+    * mirror repeat, clamp to zero, clamp to border colour */
+   static const unsigned wrap[] = {
+      PIPE_TEX_WRAP_CLAMP_TO_EDGE, PIPE_TEX_WRAP_MIRROR_CLAMP_TO_EDGE, PIPE_TEX_WRAP_REPEAT,
+      PIPE_TEX_WRAP_MIRROR_REPEAT, PIPE_TEX_WRAP_CLAMP_TO_BORDER, PIPE_TEX_WRAP_CLAMP_TO_BORDER,
+   };
+   static const unsigned func[] = {   /* MTLCompareFunction, in PIPE_FUNC_x's order */
+      PIPE_FUNC_NEVER, PIPE_FUNC_LESS, PIPE_FUNC_EQUAL, PIPE_FUNC_LEQUAL, PIPE_FUNC_GREATER,
+      PIPE_FUNC_NOTEQUAL, PIPE_FUNC_GEQUAL, PIPE_FUNC_ALWAYS,
+   };
+   struct pipe_sampler_state st = {
+      .wrap_s = wrap[d->s % 6],
+      .wrap_t = wrap[d->t % 6],
+      .wrap_r = wrap[d->r % 6],
+      .min_img_filter = d->min_filter ? PIPE_TEX_FILTER_LINEAR : PIPE_TEX_FILTER_NEAREST,
+      .mag_img_filter = d->mag_filter ? PIPE_TEX_FILTER_LINEAR : PIPE_TEX_FILTER_NEAREST,
+      .min_mip_filter = d->mip_filter == 2 ? PIPE_TEX_MIPFILTER_LINEAR :
+                        d->mip_filter == 1 ? PIPE_TEX_MIPFILTER_NEAREST : PIPE_TEX_MIPFILTER_NONE,
+      .unnormalized_coords = !d->normalized,
+      .max_anisotropy = d->max_aniso > 1 ? d->max_aniso : 0,
+      .min_lod = d->lod_min,
+      .max_lod = d->lod_max,
+   };
+   if (d->compare) {
+      st.compare_mode = PIPE_TEX_COMPARE_R_TO_TEXTURE;
+      st.compare_func = func[d->compare % 8];
+   }
+   if (d->s == 4 || d->t == 4 || d->r == 4) {
+      /* clamp to zero: the zero border */
+   } else {
+      float v = d->border == 2 ? 1.0f : 0.0f;
+      st.border_color.f[0] = st.border_color.f[1] = st.border_color.f[2] = v;
+      st.border_color.f[3] = d->border == 0 ? 0.0f : 1.0f;
+   }
+   pthread_mutex_lock(&gpu->lock);
+   void *cso = gpu->ctx->create_sampler_state(gpu->ctx, &st);
+   pthread_mutex_unlock(&gpu->lock);
+   return cso;
+}
+
+PUBLIC void
+lapis_gpu_sampler_free(struct lapis_gpu *gpu, void *sampler)
+{
+   if (!sampler)
+      return;
+   pthread_mutex_lock(&gpu->lock);
+   gpu->ctx->delete_sampler_state(gpu->ctx, sampler);
+   pthread_mutex_unlock(&gpu->lock);
+}
+
+/* MTLVertexFormat -> pipe_format; NONE for one not done */
+static enum pipe_format
+mtl_vertex_format(unsigned f)
+{
+   switch (f) {
+   case 3: return PIPE_FORMAT_R8G8B8A8_UINT;           /* UChar4 */
+   case 6: return PIPE_FORMAT_R8G8B8A8_SINT;           /* Char4 */
+   case 7: return PIPE_FORMAT_R8G8_UNORM;              /* UChar2Normalized */
+   case 9: return PIPE_FORMAT_R8G8B8A8_UNORM;          /* UChar4Normalized */
+   case 12: return PIPE_FORMAT_R8G8B8A8_SNORM;         /* Char4Normalized */
+   case 13: return PIPE_FORMAT_R16G16_UINT;            /* UShort2 */
+   case 15: return PIPE_FORMAT_R16G16B16A16_UINT;      /* UShort4 */
+   case 16: return PIPE_FORMAT_R16G16_SINT;            /* Short2 */
+   case 18: return PIPE_FORMAT_R16G16B16A16_SINT;      /* Short4 */
+   case 19: return PIPE_FORMAT_R16G16_UNORM;           /* UShort2Normalized */
+   case 21: return PIPE_FORMAT_R16G16B16A16_UNORM;     /* UShort4Normalized */
+   case 22: return PIPE_FORMAT_R16G16_SNORM;           /* Short2Normalized */
+   case 24: return PIPE_FORMAT_R16G16B16A16_SNORM;     /* Short4Normalized */
+   case 25: return PIPE_FORMAT_R16G16_FLOAT;           /* Half2 */
+   case 27: return PIPE_FORMAT_R16G16B16A16_FLOAT;     /* Half4 */
+   case 28: return PIPE_FORMAT_R32_FLOAT;              /* Float */
+   case 29: return PIPE_FORMAT_R32G32_FLOAT;           /* Float2 */
+   case 30: return PIPE_FORMAT_R32G32B32_FLOAT;        /* Float3 */
+   case 31: return PIPE_FORMAT_R32G32B32A32_FLOAT;     /* Float4 */
+   case 32: return PIPE_FORMAT_R32_SINT;               /* Int */
+   case 33: return PIPE_FORMAT_R32G32_SINT;            /* Int2 */
+   case 34: return PIPE_FORMAT_R32G32B32_SINT;         /* Int3 */
+   case 35: return PIPE_FORMAT_R32G32B32A32_SINT;      /* Int4 */
+   case 36: return PIPE_FORMAT_R32_UINT;               /* UInt */
+   case 37: return PIPE_FORMAT_R32G32_UINT;            /* UInt2 */
+   case 38: return PIPE_FORMAT_R32G32B32_UINT;         /* UInt3 */
+   case 39: return PIPE_FORMAT_R32G32B32A32_UINT;      /* UInt4 */
+   case 42: return PIPE_FORMAT_B8G8R8A8_UNORM;         /* UChar4Normalized_BGRA */
+   case 53: return PIPE_FORMAT_R16_FLOAT;              /* Half */
+   default: return PIPE_FORMAT_NONE;
+   }
+}
+
+#define LAPIS_ZERO_VB 31u                /* the vertex buffer slot of zeros (no Metal index) */
+static struct lapis_gpu_buf *zero_vb;
+
+/* The AIR reflection lists buffers touched in all specialized code paths. Filter
+ * constant buffers whose loads vanish after Metal's function constants are
+ * folded; those slots need not be bound for this pipeline variant. */
+static bool
+nir_uses_ubo(nir_shader *nir, unsigned metal_index)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            if (in->intrinsic != nir_intrinsic_load_ubo)
+               continue;
+            if (!nir_src_is_const(in->src[0]) ||
+                nir_src_as_uint(in->src[0]) == metal_index + LAPIS_UBO_SHIFT)
+               return true;
+         }
+      }
+   }
+   return false;
+}
+
+/* one stage of a pipeline: AIR -> NIR -> a panfrost shader state */
+static bool
+stage_new(struct lapis_gpu *gpu, struct lapis_gpu_stage *st, mesa_shader_stage want, const void *bc,
+          size_t size, const char *entry, struct lapis_gpu_render *r, const struct lapis_gpu_render_desc *desc,
+          const struct lapis_gpu_render_desc *consts_desc, char *error, size_t error_size)
+{
+   void *mem = ralloc_context(NULL);
+   struct air_shader_info info;
+   struct air_to_nir_options opts;
+   const char *why = NULL;
+   memset(&info, 0, sizeof(info));
+   memset(&opts, 0, sizeof(opts));
+   if (consts_desc)
+      fill_constants(mem, bc, size, want == MESA_SHADER_VERTEX ? consts_desc->vs_consts : consts_desc->fs_consts,
+                     want == MESA_SHADER_VERTEX ? consts_desc->num_vs_consts : consts_desc->num_fs_consts, &opts);
+   nir_shader *nir = air_to_nir(mem, bc, size, entry, &opts, gpu->screen->nir_options[want], &info, &why);
+   if (!nir || nir->info.stage != want) {
+      snprintf(error, error_size, "%s: %s", entry,
+               !nir ? (why ? why : "air_to_nir failed") : "not the stage the pipeline wants it for");
+      ralloc_free(mem);
+      return false;
+   }
+   shift_ubos(nir);
+   bool progress;
+   unsigned rounds = 0;
+   do {
+      progress = false;
+      NIR_PASS(progress, nir, nir_opt_copy_prop);
+      NIR_PASS(progress, nir, nir_opt_constant_folding);
+      NIR_PASS(progress, nir, nir_opt_dce);
+      NIR_PASS(progress, nir, nir_opt_dead_cf);
+      NIR_PASS(progress, nir, nir_opt_if, nir_opt_if_optimize_phi_true_false);
+   } while (progress && ++rounds < 16);
+   for (unsigned i = 0; i < info.num_resources && st->num_res < LAPIS_GPU_MAX_RES; i++) {
+      if (info.resources[i].kind == AIR_RESOURCE_CONSTANT_BUFFER &&
+          !nir_uses_ubo(nir, info.resources[i].index))
+         continue;
+      st->res[st->num_res].kind = info.resources[i].kind;
+      st->res[st->num_res].index = info.resources[i].index;
+      st->res[st->num_res].write = info.resources[i].write || info.resources[i].ir_write;
+      st->res[st->num_res].null_texture = info.resources[i].null_texture;
+      st->num_res++;
+      const struct air_resource *ar = &info.resources[i];
+      if (ar->kind == AIR_RESOURCE_SAMPLER && ar->inline_sampler && ar->index < LAPIS_GPU_MAX_SAMPLERS) {
+         struct pipe_sampler_state ss = sampler_from_air(&ar->sampler);
+         pthread_mutex_lock(&gpu->lock);
+         st->inline_sampler[ar->index] = gpu->ctx->create_sampler_state(gpu->ctx, &ss);
+         pthread_mutex_unlock(&gpu->lock);
+      }
+   }
+   /* [[stage_in]]: gallium feeds vertex element i to the input whose
+    * driver_location is i (nir_air.h); each element's buffer gets a vertex
+    * buffer slot of its own, in the order first met */
+   /*
+    * An attribute the vertex descriptor gives no format (0) is fed zeros
+    * from a small buffer of zeros (stride 0), in the slot of Metal buffer
+    * index 31, which no Metal binding has: AIR lists an attribute gated by a
+    * function constant as used whatever the constant says (nir_air.h), and
+    * CoreAnimation's fixed_vert_lph_spc has one at 4 its descriptor leaves
+    * out; refusing the pipeline made CoreAnimation abort (m7w).
+    */
+   if (r && info.num_vertex_attributes) {
+      unsigned n = 0;
+      for (unsigned i = 0; i < info.num_vertex_attributes; i++) {
+         const struct air_vertex_attribute *va = &info.vertex_attributes[i];
+         if (!va->used)
+            continue;
+         unsigned idx = va->index, dl = va->driver_location;
+         enum pipe_format pf = desc && idx < 31 ? mtl_vertex_format(desc->attribs[idx].format) : PIPE_FORMAT_NONE;
+         bool zeros = desc && idx < 31 && desc->attribs[idx].format == 0 && dl < PIPE_MAX_ATTRIBS;
+         if (zeros) {
+            if (!zero_vb)
+               zero_vb = lapis_gpu_buf_new(gpu, 256);
+            unsigned slot = 0;
+            while (slot < r->num_vb && r->vb_buffer[slot] != LAPIS_ZERO_VB)
+               slot++;
+            if (slot == r->num_vb)
+               r->vb_buffer[r->num_vb++] = LAPIS_ZERO_VB;
+            struct pipe_vertex_element *ve = &r->velems.velems[dl];
+            ve->src_offset = 0;
+            ve->vertex_buffer_index = slot;
+            ve->src_format = PIPE_FORMAT_R32G32B32A32_FLOAT;
+            ve->src_stride = 0;
+            ve->instance_divisor = 0;
+            n = MAX2(n, dl + 1);
+            continue;
+         }
+         if (pf == PIPE_FORMAT_NONE || dl >= PIPE_MAX_ATTRIBS) {
+            snprintf(error, error_size, "%s: attribute %u has no vertex descriptor format this port reads (%u)",
+                     entry, idx, desc && idx < 31 ? desc->attribs[idx].format : 0);
+            ralloc_free(mem);
+            return false;
+         }
+         unsigned buf = desc->attribs[idx].buffer % 31, slot = 0;
+         while (slot < r->num_vb && r->vb_buffer[slot] != buf)
+            slot++;
+         if (slot == r->num_vb)
+            r->vb_buffer[r->num_vb++] = buf;
+         struct pipe_vertex_element *ve = &r->velems.velems[dl];
+         ve->src_offset = (uint16_t)desc->attribs[idx].offset;
+         ve->vertex_buffer_index = slot;
+         ve->src_format = pf;
+         ve->src_stride = desc->layouts[buf].stride;
+         ve->instance_divisor = desc->layouts[buf].step_function == 2 ? MAX2(desc->layouts[buf].step_rate, 1) : 0;
+         n = MAX2(n, dl + 1);
+      }
+      r->velems.count = n;
+   }
+   {
+      char *text = NULL;
+      size_t len = 0;
+      FILE *f = open_memstream(&text, &len);
+      if (f) {
+         nir_print_shader(nir, f);
+         fclose(f);
+         st->nir_text = text;
+      }
+   }
+   ralloc_steal(NULL, nir);
+   ralloc_free(mem);
+   struct pipe_shader_state ss = { .type = PIPE_SHADER_IR_NIR, .ir.nir = nir };
+   pthread_mutex_lock(&gpu->lock);
+   st->cso = want == MESA_SHADER_VERTEX ? gpu->ctx->create_vs_state(gpu->ctx, &ss)
+                                        : gpu->ctx->create_fs_state(gpu->ctx, &ss);
+   pthread_mutex_unlock(&gpu->lock);
+   if (!st->cso) {
+      snprintf(error, error_size, "%s: panfrost refused the shader", entry);
+      return false;
+   }
+   return true;
+}
+
+PUBLIC void
+lapis_gpu_render_free(struct lapis_gpu *gpu, struct lapis_gpu_render *r)
+{
+   if (!r)
+      return;
+   pthread_mutex_lock(&gpu->lock);
+   if (r->vs.cso)
+      gpu->ctx->delete_vs_state(gpu->ctx, r->vs.cso);
+   if (r->fs.cso)
+      gpu->ctx->delete_fs_state(gpu->ctx, r->fs.cso);
+   for (unsigned i = 0; i < LAPIS_GPU_MAX_SAMPLERS; i++) {
+      if (r->vs.inline_sampler[i])
+         gpu->ctx->delete_sampler_state(gpu->ctx, r->vs.inline_sampler[i]);
+      if (r->fs.inline_sampler[i])
+         gpu->ctx->delete_sampler_state(gpu->ctx, r->fs.inline_sampler[i]);
+   }
+   pthread_mutex_unlock(&gpu->lock);
+   free(r->vs.nir_text);
+   free(r->fs.nir_text);
+   free(r);
+}
+
+/* a stage's NIR as text into OUT (cut at SIZE - 1); its whole length */
+PUBLIC size_t
+lapis_gpu_render_nir(struct lapis_gpu_render *r, int fragment, char *out, size_t size)
+{
+   const char *t = r ? (fragment ? r->fs.nir_text : r->vs.nir_text) : NULL;
+   if (!t)
+      t = "";
+   if (size)
+      snprintf(out, size, "%s", t);
+   return strlen(t);
+}
+
+/* MTLBlendFactor -> PIPE_BLENDFACTOR_x */
+static unsigned
+mtl_blend_factor(unsigned f)
+{
+   static const unsigned t[] = {
+      PIPE_BLENDFACTOR_ZERO, PIPE_BLENDFACTOR_ONE, PIPE_BLENDFACTOR_SRC_COLOR, PIPE_BLENDFACTOR_INV_SRC_COLOR,
+      PIPE_BLENDFACTOR_SRC_ALPHA, PIPE_BLENDFACTOR_INV_SRC_ALPHA, PIPE_BLENDFACTOR_DST_COLOR,
+      PIPE_BLENDFACTOR_INV_DST_COLOR, PIPE_BLENDFACTOR_DST_ALPHA, PIPE_BLENDFACTOR_INV_DST_ALPHA,
+      PIPE_BLENDFACTOR_SRC_ALPHA_SATURATE, PIPE_BLENDFACTOR_CONST_COLOR, PIPE_BLENDFACTOR_INV_CONST_COLOR,
+      PIPE_BLENDFACTOR_CONST_ALPHA, PIPE_BLENDFACTOR_INV_CONST_ALPHA, PIPE_BLENDFACTOR_SRC1_COLOR,
+      PIPE_BLENDFACTOR_INV_SRC1_COLOR, PIPE_BLENDFACTOR_SRC1_ALPHA, PIPE_BLENDFACTOR_INV_SRC1_ALPHA,
+   };
+   return f < ARRAY_SIZE(t) ? t[f] : PIPE_BLENDFACTOR_ONE;
+}
+
+PUBLIC struct lapis_gpu_render *lapis_gpu_render_new2(struct lapis_gpu *gpu, const void *vs, size_t vs_size,
+                                                      const char *vs_entry, const void *fs, size_t fs_size,
+                                                      const char *fs_entry, const struct lapis_gpu_render_desc *desc,
+                                                      char *error, size_t error_size);
+
+PUBLIC struct lapis_gpu_render *
+lapis_gpu_render_new2(struct lapis_gpu *gpu, const void *vs, size_t vs_size, const char *vs_entry, const void *fs,
+                      size_t fs_size, const char *fs_entry, const struct lapis_gpu_render_desc *desc, char *error,
+                      size_t error_size)
+{
+   struct lapis_gpu_render *r = calloc(1, sizeof(*r));
+   if (!stage_new(gpu, &r->vs, MESA_SHADER_VERTEX, vs, vs_size, vs_entry, r, desc, desc, error, error_size) ||
+       !stage_new(gpu, &r->fs, MESA_SHADER_FRAGMENT, fs, fs_size, fs_entry, NULL, NULL, desc, error, error_size)) {
+      lapis_gpu_render_free(gpu, r);
+      return NULL;
+   }
+   /* colour attachment 0's blending; MTLColorWriteMask is RGBA from bit 3 down */
+   unsigned wm = desc ? desc->write_mask : 0xf;
+   r->blend.rt[0].colormask = ((wm & 8) ? PIPE_MASK_R : 0) | ((wm & 4) ? PIPE_MASK_G : 0) |
+                              ((wm & 2) ? PIPE_MASK_B : 0) | ((wm & 1) ? PIPE_MASK_A : 0);
+   if (desc && desc->blend_enabled) {
+      static const unsigned op[] = { PIPE_BLEND_ADD, PIPE_BLEND_SUBTRACT, PIPE_BLEND_REVERSE_SUBTRACT,
+                                     PIPE_BLEND_MIN, PIPE_BLEND_MAX };
+      r->blend.rt[0].blend_enable = 1;
+      r->blend.rt[0].rgb_func = op[desc->rgb_op % 5];
+      r->blend.rt[0].alpha_func = op[desc->alpha_op % 5];
+      r->blend.rt[0].rgb_src_factor = mtl_blend_factor(desc->src_rgb);
+      r->blend.rt[0].rgb_dst_factor = mtl_blend_factor(desc->dst_rgb);
+      r->blend.rt[0].alpha_src_factor = mtl_blend_factor(desc->src_alpha);
+      r->blend.rt[0].alpha_dst_factor = mtl_blend_factor(desc->dst_alpha);
+   }
+   return r;
+}
+
+PUBLIC struct lapis_gpu_render *
+lapis_gpu_render_new(struct lapis_gpu *gpu, const void *vs, size_t vs_size, const char *vs_entry, const void *fs,
+                     size_t fs_size, const char *fs_entry, char *error, size_t error_size)
+{
+   return lapis_gpu_render_new2(gpu, vs, vs_size, vs_entry, fs, fs_size, fs_entry, NULL, error, error_size);
+}
+
+/* the render pass state the draws use, kept from lapis_gpu_pass_begin */
+static struct cso_context *lapis_cso;
+static unsigned pass_w, pass_h;
+
+/* Metal's viewport (origin at the top left, depth near..far) */
+static void
+set_viewport(double x, double y, double w, double h, double znear, double zfar)
+{
+   struct pipe_viewport_state vp = {
+      .scale = { (float)(w / 2), (float)(-h / 2), (float)(zfar - znear) },
+      .translate = { (float)(x + w / 2), (float)(y + h / 2), (float)znear },
+      .swizzle_x = PIPE_VIEWPORT_SWIZZLE_POSITIVE_X,
+      .swizzle_y = PIPE_VIEWPORT_SWIZZLE_POSITIVE_Y,
+      .swizzle_z = PIPE_VIEWPORT_SWIZZLE_POSITIVE_Z,
+      .swizzle_w = PIPE_VIEWPORT_SWIZZLE_POSITIVE_W,
+   };
+   cso_set_viewport(lapis_cso, &vp);
+}
+
+PUBLIC void lapis_gpu_viewport(struct lapis_gpu *gpu, const double v[6]);
+PUBLIC void lapis_gpu_scissor(struct lapis_gpu *gpu, unsigned x, unsigned y, unsigned w, unsigned h);
+PUBLIC void lapis_gpu_blend_color(struct lapis_gpu *gpu, const float rgba[4]);
+PUBLIC int lapis_gpu_draw2(struct lapis_gpu *gpu, struct lapis_gpu_render *r, const struct lapis_gpu_draw_args *a);
+
+/* MTLViewport: originX, originY, width, height, znear, zfar (after pass_begin) */
+PUBLIC void
+lapis_gpu_viewport(struct lapis_gpu *gpu, const double v[6])
+{
+   pthread_mutex_lock(&gpu->lock);
+   if (lapis_cso)
+      set_viewport(v[0], v[1], v[2], v[3], v[4], v[5]);
+   pthread_mutex_unlock(&gpu->lock);
+}
+
+PUBLIC void
+lapis_gpu_scissor(struct lapis_gpu *gpu, unsigned x, unsigned y, unsigned w, unsigned h)
+{
+   unsigned x1 = MIN2(x + w, pass_w), y1 = MIN2(y + h, pass_h);
+   struct pipe_scissor_state sc = { (uint16_t)MIN2(x, x1), (uint16_t)MIN2(y, y1), (uint16_t)x1, (uint16_t)y1 };
+   pthread_mutex_lock(&gpu->lock);
+   gpu->ctx->set_scissor_states(gpu->ctx, 0, 1, &sc);
+   pthread_mutex_unlock(&gpu->lock);
+}
+
+PUBLIC void
+lapis_gpu_blend_color(struct lapis_gpu *gpu, const float rgba[4])
+{
+   struct pipe_blend_color c = { { rgba[0], rgba[1], rgba[2], rgba[3] } };
+   pthread_mutex_lock(&gpu->lock);
+   gpu->ctx->set_blend_color(gpu->ctx, &c);
+   pthread_mutex_unlock(&gpu->lock);
+}
+
+PUBLIC int
+lapis_gpu_pass_begin(struct lapis_gpu *gpu, struct lapis_gpu_tex *target, int clear, const double rgba[4])
+{
+   if (!target)
+      return -1;
+   pthread_mutex_lock(&gpu->lock);
+   if (!lapis_cso)
+      lapis_cso = cso_create_context(gpu->ctx, 0);
+   struct pipe_framebuffer_state fb;
+   memset(&fb, 0, sizeof(fb));
+   fb.width = target->width;
+   fb.height = target->height;
+   fb.layers = 1;
+   fb.nr_cbufs = 1;
+   fb.cbufs[0].format = target->res->format;
+   fb.cbufs[0].texture = target->res;
+   cso_set_framebuffer(lapis_cso, &fb);
+   pass_w = target->width;
+   pass_h = target->height;
+
+   struct pipe_blend_state blend;
+   memset(&blend, 0, sizeof(blend));
+   blend.rt[0].colormask = PIPE_MASK_RGBA;
+   struct pipe_rasterizer_state rast;
+   memset(&rast, 0, sizeof(rast));
+   rast.cull_face = PIPE_FACE_NONE;
+   rast.half_pixel_center = 1;
+   rast.bottom_edge_rule = 1;
+   rast.depth_clip_near = 1;
+   rast.depth_clip_far = 1;
+   rast.clip_halfz = 1;
+   rast.scissor = 1;
+   struct pipe_depth_stencil_alpha_state dsa;
+   memset(&dsa, 0, sizeof(dsa));
+   cso_set_blend(lapis_cso, &blend);
+   cso_set_rasterizer(lapis_cso, &rast);
+   cso_set_depth_stencil_alpha(lapis_cso, &dsa);
+   set_viewport(0, 0, pass_w, pass_h, 0, 1);
+   struct pipe_scissor_state sc = { 0, 0, (uint16_t)pass_w, (uint16_t)pass_h };
+   gpu->ctx->set_scissor_states(gpu->ctx, 0, 1, &sc);
+   struct cso_velems_state velems;
+   memset(&velems, 0, sizeof(velems));
+   cso_set_vertex_elements(lapis_cso, &velems);
+   if (clear) {
+      union pipe_color_union color = { .f = { (float)rgba[0], (float)rgba[1], (float)rgba[2], (float)rgba[3] } };
+      gpu->ctx->clear(gpu->ctx, PIPE_CLEAR_COLOR0, 0xf, 0, NULL, &color, 0.0, 0);
+   }
+   pthread_mutex_unlock(&gpu->lock);
+   return 0;
+}
+
+/* a texture's sampler view, made the first time a shader reads it (lock held) */
+static struct pipe_sampler_view *
+tex_view(struct lapis_gpu *gpu, struct lapis_gpu_tex *t)
+{
+   if (!t->view) {
+      struct pipe_sampler_view templ;
+      u_sampler_view_default_template(&templ, t->res, t->res->format);
+      t->view = gpu->ctx->create_sampler_view(gpu->ctx, t->res, &templ);
+   }
+   return t->view;
+}
+
+/* Metal's null texture: a 1x1 zero texture (nir_air.h, air_resource.null_texture) */
+static struct pipe_sampler_view *
+null_view(struct lapis_gpu *gpu)
+{
+   static struct lapis_gpu_tex *t;
+   if (!t) {
+      struct pipe_resource templ = {
+         .target = PIPE_TEXTURE_2D, .format = PIPE_FORMAT_R8G8B8A8_UNORM, .width0 = 1, .height0 = 1,
+         .depth0 = 1, .array_size = 1, .bind = PIPE_BIND_SAMPLER_VIEW, .usage = PIPE_USAGE_DEFAULT,
+      };
+      t = calloc(1, sizeof(*t));
+      t->res = gpu->screen->resource_create(gpu->screen, &templ);
+      t->width = t->height = 1;
+      t->bpp = 4;
+      static const uint32_t zero = 0;
+      struct pipe_box box;
+      u_box_2d(0, 0, 1, 1, &box);
+      gpu->ctx->texture_subdata(gpu->ctx, t->res, 0, PIPE_MAP_WRITE, &box, &zero, 4, 0);
+   }
+   return tex_view(gpu, t);
+}
+
+/* the sampler Metal binds when none is: nearest, clamp to edge, normalized */
+static void *
+default_sampler(struct lapis_gpu *gpu)
+{
+   static void *s;
+   if (!s) {
+      struct pipe_sampler_state st = {
+         .wrap_s = PIPE_TEX_WRAP_CLAMP_TO_EDGE, .wrap_t = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+         .wrap_r = PIPE_TEX_WRAP_CLAMP_TO_EDGE, .min_img_filter = PIPE_TEX_FILTER_NEAREST,
+         .mag_img_filter = PIPE_TEX_FILTER_NEAREST, .min_mip_filter = PIPE_TEX_MIPFILTER_NONE,
+      };
+      s = gpu->ctx->create_sampler_state(gpu->ctx, &st);
+   }
+   return s;
+}
+
+/* a stage's resources by Metal index; 0, or what is missing:
+ * 1000 + a device buffer, 4000 + a constant buffer,
+ * 2000 + a texture, 3000 + a sampler (the fragment stage adds 10000). */
+static int
+bind_stage(struct lapis_gpu *gpu, mesa_shader_stage stage, const struct lapis_gpu_stage *st,
+           struct lapis_gpu_buf *const *bufs, const uint64_t *offsets, unsigned num_bufs,
+           struct lapis_gpu_tex *const *texes, void *const *samplers)
+{
+   struct pipe_shader_buffer ssbo[32];
+   struct pipe_sampler_view *views[LAPIS_GPU_MAX_TEXTURES + 1];
+   void *samp[LAPIS_GPU_MAX_SAMPLERS];
+   unsigned num_ssbo = 0, writable = 0, num_views = 0, num_samp = 0;
+   memset(ssbo, 0, sizeof(ssbo));
+   memset(views, 0, sizeof(views));
+   memset(samp, 0, sizeof(samp));
+   for (unsigned i = 0; i < st->num_res; i++) {
+      unsigned idx = st->res[i].index;
+      int kind = st->res[i].kind;
+      if (kind == AIR_RESOURCE_TEXTURE) {
+         if (idx > LAPIS_GPU_MAX_TEXTURES)
+            return 2000 + (int)idx;
+         if (st->res[i].null_texture)
+            views[idx] = null_view(gpu);
+         else if (texes && idx < LAPIS_GPU_MAX_TEXTURES && texes[idx])
+            views[idx] = tex_view(gpu, texes[idx]);
+         else
+            return 2000 + (int)idx;
+         num_views = MAX2(num_views, idx + 1);
+         continue;
+      }
+      if (kind == AIR_RESOURCE_SAMPLER) {
+         if (idx >= LAPIS_GPU_MAX_SAMPLERS)
+            return 3000 + (int)idx;
+         samp[idx] = st->inline_sampler[idx] ? st->inline_sampler[idx]
+                     : (samplers && samplers[idx]) ? samplers[idx] : default_sampler(gpu);
+         num_samp = MAX2(num_samp, idx + 1);
+         continue;
+      }
+      if (kind != AIR_RESOURCE_DEVICE_BUFFER && kind != AIR_RESOURCE_CONSTANT_BUFFER)
+         continue;
+      if (idx >= num_bufs || idx >= 32 || !bufs[idx])
+         return (kind == AIR_RESOURCE_CONSTANT_BUFFER ? 4000 : 1000) + (int)idx;
+      uint64_t off = offsets ? offsets[idx] : 0;
+      if (kind == AIR_RESOURCE_DEVICE_BUFFER) {
+         ssbo[idx].buffer = bufs[idx]->res;
+         ssbo[idx].buffer_offset = (unsigned)off;
+         ssbo[idx].buffer_size = (unsigned)(bufs[idx]->size - off);
+         if (st->res[i].write)
+            writable |= 1u << idx;
+         if (idx + 1 > num_ssbo)
+            num_ssbo = idx + 1;
+      } else {
+         struct pipe_constant_buffer cb = {
+            .buffer = bufs[idx]->res,
+            .buffer_offset = (unsigned)off,
+            .buffer_size = (unsigned)(bufs[idx]->size - off),
+         };
+         gpu->ctx->set_constant_buffer(gpu->ctx, stage, idx + LAPIS_UBO_SHIFT, &cb);
+      }
+   }
+   /* a sampled texture with no sampler resource at its slot still needs one there */
+   for (unsigned i = 0; i < num_views && i < LAPIS_GPU_MAX_SAMPLERS; i++) {
+      if (!samp[i]) {
+         samp[i] = default_sampler(gpu);
+         num_samp = MAX2(num_samp, i + 1);
+      }
+   }
+   if (num_ssbo)
+      gpu->ctx->set_shader_buffers(gpu->ctx, stage, 0, num_ssbo, ssbo, writable);
+   if (num_views)
+      gpu->ctx->set_sampler_views(gpu->ctx, stage, 0, num_views, 0, views);
+   if (num_samp) {
+      for (unsigned i = 0; i < num_samp; i++)
+         if (!samp[i])
+            samp[i] = default_sampler(gpu);
+      gpu->ctx->bind_sampler_states(gpu->ctx, stage, 0, num_samp, samp);
+   }
+   return 0;
+}
+
+/* a draw: 0, or -1 when something a shader uses is not bound (nothing drawn) */
+PUBLIC int
+lapis_gpu_draw2(struct lapis_gpu *gpu, struct lapis_gpu_render *r, const struct lapis_gpu_draw_args *a)
+{
+   static const enum mesa_prim prims[] = { MESA_PRIM_POINTS, MESA_PRIM_LINES, MESA_PRIM_LINE_STRIP,
+                                           MESA_PRIM_TRIANGLES, MESA_PRIM_TRIANGLE_STRIP };
+   if (!r || !lapis_cso || a->mtl_prim > 4 || !a->count)
+      return -1;
+   pthread_mutex_lock(&gpu->lock);
+   int missing = bind_stage(gpu, MESA_SHADER_VERTEX, &r->vs, a->vbufs, a->voffs, 31, a->vtex, a->vsamp);
+   if (!missing) {
+      missing = bind_stage(gpu, MESA_SHADER_FRAGMENT, &r->fs, a->fbufs, a->foffs, 31, a->ftex, a->fsamp);
+      missing = missing ? missing + 10000 : 0;   /* 1xxxx: the fragment stage's */
+   }
+   if (missing) {
+      pthread_mutex_unlock(&gpu->lock);
+      return -missing;   /* -(1000+i) a vertex buffer, -(2000+i) a vertex texture, -(1xxxx) the fragment stage's */
+   }
+   struct pipe_vertex_buffer vb[PIPE_MAX_ATTRIBS];
+   memset(vb, 0, sizeof(vb));
+   for (unsigned i = 0; i < r->num_vb; i++) {
+      struct lapis_gpu_buf *b = r->vb_buffer[i] == LAPIS_ZERO_VB ? zero_vb : a->vbufs[r->vb_buffer[i]];
+      if (!b) {
+         pthread_mutex_unlock(&gpu->lock);
+         return -1;
+      }
+      vb[i].buffer.resource = b->res;
+      vb[i].buffer_offset = r->vb_buffer[i] == LAPIS_ZERO_VB ? 0 : (unsigned)a->voffs[r->vb_buffer[i]];
+   }
+   cso_set_vertex_elements(lapis_cso, &r->velems);
+   cso_set_vertex_buffers(lapis_cso, r->num_vb, vb);
+   cso_set_blend(lapis_cso, &r->blend);
+   cso_set_vertex_shader_handle(lapis_cso, r->vs.cso);
+   cso_set_fragment_shader_handle(lapis_cso, r->fs.cso);
+   struct pipe_draw_info info;
+   memset(&info, 0, sizeof(info));
+   info.mode = prims[a->mtl_prim];
+   info.start_instance = a->base_instance;
+   info.instance_count = a->instances ? a->instances : 1;
+   struct pipe_draw_start_count_bias draw = { .start = a->start, .count = a->count, .index_bias = a->base_vertex };
+   if (a->ibuf) {
+      info.index_size = (uint16_t)(a->index_size == 2 ? 2 : 4);
+      info.index.resource = a->ibuf->res;
+      draw.start = (unsigned)(a->ioff / info.index_size);
+   }
+   cso_draw_vbo(lapis_cso, &info, 0, NULL, &draw, 1);
+   pthread_mutex_unlock(&gpu->lock);
+   return 0;
+}
+
+PUBLIC int
+lapis_gpu_draw(struct lapis_gpu *gpu, struct lapis_gpu_render *r, struct lapis_gpu_buf *const *vbufs,
+               const uint64_t *voffsets, struct lapis_gpu_buf *const *fbufs, const uint64_t *foffsets,
+               unsigned num_bufs, unsigned mtl_prim, unsigned start, unsigned count, unsigned instances)
+{
+   struct lapis_gpu_draw_args a;
+   memset(&a, 0, sizeof(a));
+   for (unsigned i = 0; i < num_bufs && i < 31; i++) {
+      a.vbufs[i] = vbufs[i];
+      a.fbufs[i] = fbufs[i];
+      a.voffs[i] = voffsets ? voffsets[i] : 0;
+      a.foffs[i] = foffsets ? foffsets[i] : 0;
+   }
+   a.mtl_prim = mtl_prim;
+   a.start = start;
+   a.count = count;
+   a.instances = instances;
+   return lapis_gpu_draw2(gpu, r, &a);
+}
