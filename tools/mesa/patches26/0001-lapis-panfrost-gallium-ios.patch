+/* the levels below level 0 made from it (blitCommandEncoder generateMipmapsForTexture:) */
+PUBLIC void lapis_gpu_gen_mipmaps(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex);
+PUBLIC int lapis_gpu_tex_copy(struct lapis_gpu *gpu, struct lapis_gpu_tex *dst, unsigned dst_level, unsigned dx,
+                              unsigned dy, struct lapis_gpu_tex *src, unsigned src_level, unsigned sx, unsigned sy,
+                              unsigned w, unsigned h);
+
+PUBLIC void
+lapis_gpu_gen_mipmaps(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex)
+{
+   if (!tex || !tex->res->last_level)
+      return;
+   pthread_mutex_lock(&gpu->lock);
+   util_gen_mipmap(gpu->ctx, tex->res, tex->res->format, 0, tex->res->last_level, 0, 0, PIPE_TEX_FILTER_LINEAR);
+   pthread_mutex_unlock(&gpu->lock);
+}
+
+/* a region of one texture's level into another's (the same format family) */
+PUBLIC int
+lapis_gpu_tex_copy(struct lapis_gpu *gpu, struct lapis_gpu_tex *dst, unsigned dst_level, unsigned dx, unsigned dy,
+                   struct lapis_gpu_tex *src, unsigned src_level, unsigned sx, unsigned sy, unsigned w, unsigned h)
+{
+   if (!dst || !src || dst_level > dst->res->last_level || src_level > src->res->last_level)
+      return -1;
+   struct pipe_box box;
+   u_box_2d((int)sx, (int)sy, (int)w, (int)h, &box);
+   pthread_mutex_lock(&gpu->lock);
+   gpu->ctx->resource_copy_region(gpu->ctx, dst->res, dst_level, dx, dy, 0, src->res, src_level, &box);
+   pthread_mutex_unlock(&gpu->lock);
+   return 0;
+}
+
+/* the CPU's copy of a region; waits for the GPU work that writes it */
+PUBLIC int
+lapis_gpu_tex_read(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex, unsigned x, unsigned y, unsigned w,
+                   unsigned h, void *dst, size_t dst_stride)
+{
+   if (!tex || !w || !h || x + w > tex->width || y + h > tex->height)
+      return -1;
+   struct pipe_transfer *xfer = NULL;
+   pthread_mutex_lock(&gpu->lock);
+   const uint8_t *map = pipe_texture_map(gpu->ctx, tex->res, 0, 0, PIPE_MAP_READ, x, y, w, h, &xfer);
+   if (map) {
+      for (unsigned r = 0; r < h; r++)
+         memcpy((uint8_t *)dst + r * dst_stride, map + r * xfer->stride, (size_t)w * tex->bpp);
+      pipe_texture_unmap(gpu->ctx, xfer);
+   }
+   pthread_mutex_unlock(&gpu->lock);
+   return map ? 0 : -1;
+}
+
+PUBLIC int
+lapis_gpu_tex_write(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex, unsigned x, unsigned y, unsigned w,
+                    unsigned h, const void *src, size_t src_stride)
+{
+   if (!tex || !w || !h || x + w > tex->width || y + h > tex->height)
+      return -1;
+   struct pipe_box box;
+   u_box_2d((int)x, (int)y, (int)w, (int)h, &box);
+   pthread_mutex_lock(&gpu->lock);
+   gpu->ctx->texture_subdata(gpu->ctx, tex->res, 0, PIPE_MAP_WRITE, &box, src, (unsigned)src_stride, 0);
+   pthread_mutex_unlock(&gpu->lock);
+   return 0;
+}
