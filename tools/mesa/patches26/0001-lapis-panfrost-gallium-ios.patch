+PUBLIC void
+lapis_gpu_copy(struct lapis_gpu *gpu, struct lapis_gpu_buf *dst, uint64_t dst_offset,
+               struct lapis_gpu_buf *src, uint64_t src_offset, uint64_t size)
+{
+   struct pipe_box box;
+   u_box_1d((int)src_offset, (int)size, &box);
+   pthread_mutex_lock(&gpu->lock);
+   gpu->ctx->resource_copy_region(gpu->ctx, dst->res, 0, (unsigned)dst_offset, 0, 0, src->res, 0, &box);
+   pthread_mutex_unlock(&gpu->lock);
+}
