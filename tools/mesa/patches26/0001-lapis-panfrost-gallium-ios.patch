+PUBLIC void
+lapis_gpu_fill(struct lapis_gpu *gpu, struct lapis_gpu_buf *buf, uint64_t offset, uint64_t size, uint8_t value)
+{
+   pthread_mutex_lock(&gpu->lock);
+   if ((offset & 3) == 0 && (size & 3) == 0) {
+      uint32_t v = value * 0x01010101u;
+      gpu->ctx->clear_buffer(gpu->ctx, buf->res, (unsigned)offset, (unsigned)size, &v, 4);
+   } else {
+      gpu->ctx->clear_buffer(gpu->ctx, buf->res, (unsigned)offset, (unsigned)size, &value, 1);
+   }
+   pthread_mutex_unlock(&gpu->lock);
+}
