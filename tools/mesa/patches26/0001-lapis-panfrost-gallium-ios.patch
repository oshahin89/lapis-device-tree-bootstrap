+/*
+ * Compute for LapisMetal: a Metal function (AIR bitcode, from a .metallib)
+ * through hakios's AIR -> NIR front end (src/compiler/air) into a panfrost
+ * compute state; its bindings as nir_air.h makes them: a `device` buffer is
+ * the SSBO at Metal's buffer index, a `constant` buffer the UBO at that
+ * index. A dispatch binds the caller's buffers by Metal index and launches
+ * the grid on the context; it is submitted with the next lapis_gpu_flush.
+ */
+#include "compiler/nir/nir.h"
+#include "compiler/air/nir_air.h"
+#include "util/ralloc.h"
+#include "compiler/nir/nir_builder.h"
+#include "util/half_float.h"
+#include "util/u_sampler.h"
+#include "util/u_gen_mipmap.h"
+
+#define LAPIS_GPU_MAX_RES 64
+
+/* a function constant LapisMetal was given (MTLFunctionConstantValues): by
+ * index, or by name when index is -1; its value as the bits of its type */
+struct lapis_gpu_constant {
+   int32_t index;
+   const char *name;
+   uint64_t bits;
+};
+
+/* the module's declared constants, with the ones given filled in, into OPTS */
+static void
+fill_constants(void *mem, const void *bc, size_t size, const struct lapis_gpu_constant *given, unsigned num_given,
+               struct air_to_nir_options *opts)
+{
+   struct air_constant_value *decl = NULL;
+   unsigned n = air_module_function_constants(mem, bc, size, &decl);
+   for (unsigned i = 0; i < n; i++) {
+      for (unsigned k = 0; k < num_given; k++) {
+         bool match = given[k].index >= 0 ? (unsigned)given[k].index == decl[i].index
+                                           : (given[k].name && decl[i].name && !strcmp(given[k].name, decl[i].name));
+         if (match) {
+            decl[i].bits = given[k].bits;
+            decl[i].supplied = true;
+         }
+      }
+   }
+   opts->constants = decl;
+   opts->num_constants = n;
+}
+
+/*
+ * Metal's constant buffer n is gallium's constant buffer n + 1: panfrost's
+ * fragment shaders read slot 0 as zero (sweetlog_m5b: `constant float4 &t
+ * [[buffer(0)]]` gave 0 in a fragment shader, [[buffer(1)]] and a device
+ * buffer at 0 were right), so slot 0 is left alone in every stage.
+ */
+#define LAPIS_UBO_SHIFT 1
+
+static bool
+shift_ubo(nir_builder *b, nir_intrinsic_instr *in, void *data)
+{
+   (void)data;
+   if (in->intrinsic != nir_intrinsic_load_ubo)
+      return false;
+   b->cursor = nir_before_instr(&in->instr);
+   nir_src_rewrite(&in->src[0], nir_iadd_imm(b, in->src[0].ssa, LAPIS_UBO_SHIFT));
+   return true;
+}
+
+/*
+ * What gallium's own frontends do before a driver sees NIR and air_to_nir
+ * leaves to the runtime: system values read through derefs of `system`
+ * variables (Metal's [[position]] in a fragment shader) become intrinsics.
+ * panfrost's compiler crashed on the deref (sweetlog_m5c: SIGSEGV in
+ * bi_alu_src_index compiling lapis_fs_pos).
+ */
+static void
+shift_ubos(nir_shader *nir)
+{
+   NIR_PASS(_, nir, nir_lower_system_values);
+   if (nir_shader_intrinsics_pass(nir, shift_ubo, nir_metadata_control_flow, NULL))
+      nir->info.num_ubos += LAPIS_UBO_SHIFT;
+}
+
+struct lapis_gpu_compute {
+   void *cso;
+   unsigned num_res;
+   struct { int kind; unsigned index; bool write; } res[LAPIS_GPU_MAX_RES];
+   unsigned shared;
+};
+
+PUBLIC int lapis_gpu_metallib_names(const void *data, size_t size, char *out, size_t out_size);
+PUBLIC int lapis_gpu_metallib_function(const void *data, size_t size, const char *name,
+                                       const void **bitcode, size_t *bitcode_size);
+PUBLIC struct lapis_gpu_compute *lapis_gpu_compute_new(struct lapis_gpu *gpu, const void *bitcode, size_t size,
+                                                       const char *entry, char *error, size_t error_size);
+PUBLIC unsigned lapis_gpu_compute_resources(struct lapis_gpu_compute *c, int *kinds, unsigned *indexes, unsigned max);
+PUBLIC void lapis_gpu_compute_free(struct lapis_gpu *gpu, struct lapis_gpu_compute *c);
+PUBLIC int lapis_gpu_dispatch(struct lapis_gpu *gpu, struct lapis_gpu_compute *c, struct lapis_gpu_buf *const *bufs,
+                              const uint64_t *offsets, unsigned num_bufs, const uint32_t grid[3],
+                              const uint32_t block[3]);
+
+/* the functions of a .metallib, NUL-separated into OUT; how many, or -1 */
+PUBLIC int
+lapis_gpu_metallib_names(const void *data, size_t size, char *out, size_t out_size)
+{
+   void *mem = ralloc_context(NULL);
+   struct air_metallib lib;
+   const char *error = NULL;
+   int n = -1;
+   if (air_metallib_parse(mem, data, size, &lib, &error)) {
+      size_t at = 0;
+      n = 0;
+      for (unsigned i = 0; i < lib.num_functions; i++) {
+         size_t len = strlen(lib.functions[i].name) + 1;
+         if (at + len > out_size)
+            break;
+         memcpy(out + at, lib.functions[i].name, len);
+         at += len;
+         n++;
+      }
+   }
+   ralloc_free(mem);
+   return n;
+}
+
+/* a function's bitcode inside the .metallib's own memory; 0, or -1 */
+PUBLIC int
+lapis_gpu_metallib_function(const void *data, size_t size, const char *name, const void **bitcode,
+                            size_t *bitcode_size)
+{
+   void *mem = ralloc_context(NULL);
+   struct air_metallib lib;
+   const char *error = NULL;
+   int r = -1;
+   if (air_metallib_parse(mem, data, size, &lib, &error)) {
+      for (unsigned i = 0; i < lib.num_functions; i++) {
+         if (strcmp(lib.functions[i].name, name) == 0) {
+            *bitcode = lib.functions[i].bitcode;
+            *bitcode_size = lib.functions[i].bitcode_size;
+            r = 0;
+            break;
+         }
+      }
+   }
+   ralloc_free(mem);
+   return r;
+}
+
+PUBLIC struct lapis_gpu_compute *lapis_gpu_compute_new2(struct lapis_gpu *gpu, const void *bitcode, size_t size,
+                                                        const char *entry, const struct lapis_gpu_constant *consts,
+                                                        unsigned num_consts, char *error, size_t error_size);
+
+PUBLIC struct lapis_gpu_compute *
+lapis_gpu_compute_new(struct lapis_gpu *gpu, const void *bitcode, size_t size, const char *entry, char *error,
+                      size_t error_size)
+{
+   return lapis_gpu_compute_new2(gpu, bitcode, size, entry, NULL, 0, error, error_size);
+}
+
+PUBLIC struct lapis_gpu_compute *
+lapis_gpu_compute_new2(struct lapis_gpu *gpu, const void *bitcode, size_t size, const char *entry,
+                       const struct lapis_gpu_constant *consts, unsigned num_consts, char *error, size_t error_size)
+{
+   void *mem = ralloc_context(NULL);
+   struct air_shader_info info;
+   struct air_to_nir_options opts;
+   const char *why = NULL;
+   memset(&info, 0, sizeof(info));
+   memset(&opts, 0, sizeof(opts));
+   fill_constants(mem, bitcode, size, consts, num_consts, &opts);
+   nir_shader *nir = air_to_nir(mem, bitcode, size, entry, &opts,
+                                gpu->screen->nir_options[MESA_SHADER_COMPUTE], &info, &why);
+   if (!nir) {
+      snprintf(error, error_size, "%s", why ? why : "air_to_nir failed");
+      ralloc_free(mem);
+      return NULL;
+   }
+   if (nir->info.stage != MESA_SHADER_COMPUTE) {
+      snprintf(error, error_size, "not a kernel (stage %d)", (int)nir->info.stage);
+      ralloc_free(mem);
+      return NULL;
+   }
+   shift_ubos(nir);
+   struct lapis_gpu_compute *c = calloc(1, sizeof(*c));
+   for (unsigned i = 0; i < info.num_resources && c->num_res < LAPIS_GPU_MAX_RES; i++) {
+      c->res[c->num_res].kind = info.resources[i].kind;
+      c->res[c->num_res].index = info.resources[i].index;
+      c->res[c->num_res].write = info.resources[i].write || info.resources[i].ir_write;
+      c->num_res++;
+   }
+   c->shared = info.threadgroup_bytes;
+   ralloc_steal(NULL, nir);
+   ralloc_free(mem);
+   struct pipe_compute_state cs = {
+      .ir_type = PIPE_SHADER_IR_NIR,
+      .prog = nir,
+      .static_shared_mem = c->shared,
+   };
+   pthread_mutex_lock(&gpu->lock);
+   c->cso = gpu->ctx->create_compute_state(gpu->ctx, &cs);
+   pthread_mutex_unlock(&gpu->lock);
+   if (!c->cso) {
+      snprintf(error, error_size, "panfrost refused the shader");
+      free(c);
+      return NULL;
+   }
+   return c;
+}
+
+PUBLIC unsigned
+lapis_gpu_compute_resources(struct lapis_gpu_compute *c, int *kinds, unsigned *indexes, unsigned max)
+{
+   unsigned n = c->num_res < max ? c->num_res : max;
+   for (unsigned i = 0; i < n; i++) {
+      kinds[i] = c->res[i].kind;
+      indexes[i] = c->res[i].index;
+   }
+   return c->num_res;
+}
+
+PUBLIC void
+lapis_gpu_compute_free(struct lapis_gpu *gpu, struct lapis_gpu_compute *c)
+{
+   if (!c)
+      return;
+   pthread_mutex_lock(&gpu->lock);
+   gpu->ctx->delete_compute_state(gpu->ctx, c->cso);
+   pthread_mutex_unlock(&gpu->lock);
+   free(c);
+}
+
+/* 0, or -1 when a buffer the kernel uses is missing (nothing is launched) */
+PUBLIC int
+lapis_gpu_dispatch(struct lapis_gpu *gpu, struct lapis_gpu_compute *c, struct lapis_gpu_buf *const *bufs,
+                   const uint64_t *offsets, unsigned num_bufs, const uint32_t grid[3], const uint32_t block[3])
+{
+   struct pipe_shader_buffer ssbo[32];
+   unsigned num_ssbo = 0, writable = 0;
+   memset(ssbo, 0, sizeof(ssbo));
+   pthread_mutex_lock(&gpu->lock);
+   for (unsigned i = 0; i < c->num_res; i++) {
+      unsigned idx = c->res[i].index;
+      if (c->res[i].kind != AIR_RESOURCE_DEVICE_BUFFER && c->res[i].kind != AIR_RESOURCE_CONSTANT_BUFFER)
+         continue;
+      if (idx >= num_bufs || !bufs[idx] || idx >= 32) {
+         pthread_mutex_unlock(&gpu->lock);
+         return -1;
+      }
+      uint64_t off = offsets ? offsets[idx] : 0;
+      if (c->res[i].kind == AIR_RESOURCE_DEVICE_BUFFER) {
+         ssbo[idx].buffer = bufs[idx]->res;
+         ssbo[idx].buffer_offset = (unsigned)off;
+         ssbo[idx].buffer_size = (unsigned)(bufs[idx]->size - off);
+         if (c->res[i].write)
+            writable |= 1u << idx;
+         if (idx + 1 > num_ssbo)
+            num_ssbo = idx + 1;
+      } else {
+         struct pipe_constant_buffer cb = {
+            .buffer = bufs[idx]->res,
+            .buffer_offset = (unsigned)off,
+            .buffer_size = (unsigned)(bufs[idx]->size - off),
+         };
+         gpu->ctx->set_constant_buffer(gpu->ctx, MESA_SHADER_COMPUTE, idx + LAPIS_UBO_SHIFT, &cb);
+      }
+   }
+   if (num_ssbo)
+      gpu->ctx->set_shader_buffers(gpu->ctx, MESA_SHADER_COMPUTE, 0, num_ssbo, ssbo, writable);
+   gpu->ctx->bind_compute_state(gpu->ctx, c->cso);
+   struct pipe_grid_info g;
+   memset(&g, 0, sizeof(g));
+   g.work_dim = 3;
+   for (unsigned k = 0; k < 3; k++) {
+      g.block[k] = block[k] ? block[k] : 1;
+      g.grid[k] = grid[k] ? grid[k] : 1;
+      g.last_block[k] = 0;
+   }
+   gpu->ctx->launch_grid(gpu->ctx, &g);
+   pthread_mutex_unlock(&gpu->lock);
+   return 0;
+}
+
+/*
+ * Rendering for LapisMetal (device/lapis_metal_plan.md, milestone 5):
+ * textures are 2D pipe_resources in a Metal pixel format, a render pipeline
+ * is a vertex and a fragment function made into panfrost shader states the
+ * same way as a kernel, a pass sets the framebuffer to one colour texture
+ * (cleared or kept), and draws bind each stage's buffers by Metal index.
+ * Metal's conventions are set here once: clip-space z in [0, 1]
+ * (clip_halfz) and y up in normalized device coordinates with the texture's
+ * first row at the top (a viewport with a negative y scale).
+ */
+struct lapis_gpu_tex {
+   struct pipe_resource *res;
+   struct pipe_sampler_view *view;   /* made the first time a shader reads it */
+   unsigned width, height, bpp;
+};
+
+#define LAPIS_GPU_MAX_SAMPLERS 16
+#define LAPIS_GPU_MAX_TEXTURES 31
+
+struct lapis_gpu_stage {
+   char *nir_text;   /* the NIR air_to_nir made, as text (lapis_gpu_render_nir) */
+   void *cso;
+   unsigned num_res;
+   struct { int kind; unsigned index; bool write; bool null_texture; } res[LAPIS_GPU_MAX_RES];
+   void *inline_sampler[LAPIS_GPU_MAX_SAMPLERS];   /* the shader's constexpr samplers, by slot */
+};
+
+/* what LapisMetal says of a pipeline beside its functions (Metal's enums) */
+struct lapis_gpu_render_desc {
+   unsigned blend_enabled, rgb_op, alpha_op, src_rgb, dst_rgb, src_alpha, dst_alpha, write_mask;
+   struct { unsigned format, offset, buffer; } attribs[31];     /* by [[attribute(n)]]; format 0: none */
+   struct { unsigned stride, step_function, step_rate; } layouts[31];   /* by buffer index */
+   const struct lapis_gpu_constant *vs_consts, *fs_consts;   /* each function's constants */
+   unsigned num_vs_consts, num_fs_consts;
+};
+
+struct lapis_gpu_render {
+   struct lapis_gpu_stage vs, fs;
+   struct pipe_blend_state blend;
+   struct cso_velems_state velems;
+   unsigned num_vb;
+   unsigned vb_buffer[PIPE_MAX_ATTRIBS];   /* vertex buffer slot -> Metal buffer index */
+};
+
+/* a draw's bindings, by Metal index (LapisMetal fills it) */
+struct lapis_gpu_draw_args {
+   struct lapis_gpu_buf *vbufs[31], *fbufs[31];
+   uint64_t voffs[31], foffs[31];
+   struct lapis_gpu_tex *vtex[31], *ftex[31];
+   void *vsamp[16], *fsamp[16];
+   unsigned mtl_prim, start, count, instances, base_instance;
+   struct lapis_gpu_buf *ibuf;   /* NULL: not indexed */
+   uint64_t ioff;
+   unsigned index_size;          /* 2 or 4 */
+   int base_vertex;
+};
+
+/* a sampler (Metal's enums) */
+struct lapis_gpu_sampler_desc {
+   unsigned min_filter, mag_filter, mip_filter, s, t, r, normalized, border, compare, max_aniso;
+   float lod_min, lod_max;
+};
+
+PUBLIC struct lapis_gpu_tex *lapis_gpu_tex_new(struct lapis_gpu *gpu, unsigned width, unsigned height,
+                                               unsigned mtl_format);
+PUBLIC void lapis_gpu_tex_free(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex);
+PUBLIC int lapis_gpu_tex_read(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex, unsigned x, unsigned y,
+                              unsigned w, unsigned h, void *dst, size_t dst_stride);
+PUBLIC int lapis_gpu_tex_write(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex, unsigned x, unsigned y,
+                               unsigned w, unsigned h, const void *src, size_t src_stride);
+PUBLIC struct lapis_gpu_render *lapis_gpu_render_new(struct lapis_gpu *gpu, const void *vs, size_t vs_size,
+                                                     const char *vs_entry, const void *fs, size_t fs_size,
+                                                     const char *fs_entry, char *error, size_t error_size);
+PUBLIC void lapis_gpu_render_free(struct lapis_gpu *gpu, struct lapis_gpu_render *r);
+PUBLIC size_t lapis_gpu_render_nir(struct lapis_gpu_render *r, int fragment, char *out, size_t size);
+PUBLIC int lapis_gpu_pass_begin(struct lapis_gpu *gpu, struct lapis_gpu_tex *target, int clear, const double rgba[4]);
+PUBLIC int lapis_gpu_draw(struct lapis_gpu *gpu, struct lapis_gpu_render *r, struct lapis_gpu_buf *const *vbufs,
+                          const uint64_t *voffsets, struct lapis_gpu_buf *const *fbufs, const uint64_t *foffsets,
+                          unsigned num_bufs, unsigned mtl_prim, unsigned start, unsigned count, unsigned instances);
+
+static enum pipe_format
+mtl_format(unsigned f, unsigned *bpp)
+{
+   *bpp = 4;
+   switch (f) {
+   case 1: *bpp = 1; return PIPE_FORMAT_A8_UNORM;           /* A8Unorm */
+   case 10: *bpp = 1; return PIPE_FORMAT_R8_UNORM;          /* MTLPixelFormatR8Unorm */
+   case 12: *bpp = 1; return PIPE_FORMAT_R8_SNORM;
+   case 13: *bpp = 1; return PIPE_FORMAT_R8_UINT;
+   case 14: *bpp = 1; return PIPE_FORMAT_R8_SINT;
+   case 20: *bpp = 2; return PIPE_FORMAT_R16_UNORM;
+   case 22: *bpp = 2; return PIPE_FORMAT_R16_SNORM;
+   case 23: *bpp = 2; return PIPE_FORMAT_R16_UINT;
+   case 24: *bpp = 2; return PIPE_FORMAT_R16_SINT;
+   case 25: *bpp = 2; return PIPE_FORMAT_R16_FLOAT;
+   case 30: *bpp = 2; return PIPE_FORMAT_R8G8_UNORM;
+   case 32: *bpp = 2; return PIPE_FORMAT_R8G8_SNORM;
+   case 33: *bpp = 2; return PIPE_FORMAT_R8G8_UINT;
+   case 34: *bpp = 2; return PIPE_FORMAT_R8G8_SINT;
+   case 53: return PIPE_FORMAT_R32_UINT;
+   case 54: return PIPE_FORMAT_R32_SINT;
+   case 60: return PIPE_FORMAT_R16G16_UNORM;
+   case 62: return PIPE_FORMAT_R16G16_SNORM;
+   case 63: return PIPE_FORMAT_R16G16_UINT;
+   case 64: return PIPE_FORMAT_R16G16_SINT;
+   case 65: return PIPE_FORMAT_R16G16_FLOAT;
+   case 72: return PIPE_FORMAT_R8G8B8A8_SNORM;
+   case 73: return PIPE_FORMAT_R8G8B8A8_UINT;
+   case 74: return PIPE_FORMAT_R8G8B8A8_SINT;
+   case 90: return PIPE_FORMAT_R10G10B10A2_UNORM;
+   case 91: return PIPE_FORMAT_R10G10B10A2_UINT;
+   case 92: return PIPE_FORMAT_R11G11B10_FLOAT;
+   case 93: return PIPE_FORMAT_R9G9B9E5_FLOAT;
+   case 94: return PIPE_FORMAT_B10G10R10A2_UNORM;
+   case 103: *bpp = 8; return PIPE_FORMAT_R32G32_UINT;
+   case 104: *bpp = 8; return PIPE_FORMAT_R32G32_SINT;
+   case 105: *bpp = 8; return PIPE_FORMAT_R32G32_FLOAT;
+   case 110: *bpp = 8; return PIPE_FORMAT_R16G16B16A16_UNORM;
+   case 112: *bpp = 8; return PIPE_FORMAT_R16G16B16A16_SNORM;
+   case 113: *bpp = 8; return PIPE_FORMAT_R16G16B16A16_UINT;
+   case 114: *bpp = 8; return PIPE_FORMAT_R16G16B16A16_SINT;
+   case 123: *bpp = 16; return PIPE_FORMAT_R32G32B32A32_UINT;
+   case 124: *bpp = 16; return PIPE_FORMAT_R32G32B32A32_SINT;
+   case 40: *bpp = 2; return PIPE_FORMAT_B5G6R5_UNORM;      /* B5G6R5Unorm */
+   case 43: *bpp = 2; return PIPE_FORMAT_B5G5R5A1_UNORM;    /* BGR5A1Unorm (CoreAnimation, after the XR formats) */
+   case 55: return PIPE_FORMAT_R32_FLOAT;                   /* R32Float */
+   case 70: return PIPE_FORMAT_R8G8B8A8_UNORM;              /* RGBA8Unorm */
+   case 71: return PIPE_FORMAT_R8G8B8A8_SRGB;               /* RGBA8Unorm_sRGB */
+   case 80: return PIPE_FORMAT_B8G8R8A8_UNORM;              /* BGRA8Unorm */
+   case 81: return PIPE_FORMAT_B8G8R8A8_SRGB;               /* BGRA8Unorm_sRGB */
+   case 115: *bpp = 8; return PIPE_FORMAT_R16G16B16A16_FLOAT;  /* RGBA16Float */
+   case 125: *bpp = 16; return PIPE_FORMAT_R32G32B32A32_FLOAT; /* RGBA32Float */
+   /* the extended-range (XR) wide-colour formats CoreAnimation uses (550,
+    * 552 BGRA10_XR, 553 its sRGB, 554 BGR10_XR, 555 its sRGB): stored as
+    * half floats, which hold their range exactly for rendering and sampling;
+    * CPU copies of them are not in Apple's packing */
+   case 550: case 552: case 553: case 554: case 555:
+      *bpp = 8; return PIPE_FORMAT_R16G16B16A16_FLOAT;
+   default: return PIPE_FORMAT_NONE;
+   }
+}
