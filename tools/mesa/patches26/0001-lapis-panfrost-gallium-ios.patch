diff -ruN a/src/gallium/targets/lapis/lapis_target.c b/src/gallium/targets/lapis/lapis_target.c
--- a/src/gallium/targets/lapis/lapis_target.c
+++ b/src/gallium/targets/lapis/lapis_target.c
@@ -0,0 +1,164 @@
+/*
+ * Copyright 2026 the lapis port authors
+ * SPDX-License-Identifier: MIT
+ *
+ * lapis: gallium panfrost on the lapis phone's Mali-G615 over LapisGPU, for
+ * programs (no GL/EGL/Vulkan frontend). lapis_gallium_screen() makes the
+ * screen; lapis_gallium_test() is the first test: a context, a linear
+ * 256x256 RGBA render target cleared on the GPU, fenced, read back, then 100
+ * clears for a rate. Everything it finds is said through log() (the
+ * program's line into the kernel's log).
+ */
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <xf86drm.h>
+
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "panfrost/pan_public.h"
+#include "util/driconf.h"
+#include "util/os_time.h"
+#include "util/u_inlines.h"
+#include "util/xmlconfig.h"
+
+static const driOptionDescription panfrost_options[] = {
+#include "panfrost/driinfo_panfrost.h"
+};
+
+typedef void (*lapis_log_fn)(const char *line);
+
+PUBLIC struct pipe_screen *lapis_gallium_screen(void);
+PUBLIC int lapis_gallium_test(lapis_log_fn log);
+
+static void
+say(lapis_log_fn log, const char *fmt, ...)
+{
+   char line[200];
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(line, sizeof(line), fmt, ap);
+   va_end(ap);
+   log(line);
+}
+
+PUBLIC struct pipe_screen *
+lapis_gallium_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   int fd = lapis_drm_open();
+
+   if (fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, panfrost_options, ARRAY_SIZE(panfrost_options));
+   driConfigFileParseParams params = { .driverName = "panfrost", .kernelDriverName = "panthor" };
+   driParseConfigFiles(&cache, &info, &params);
+   config.options = &cache;
+   config.options_info = &info;
+   return panfrost_create_screen(fd, &config, NULL);
+}
+
+static bool
+clear_and_read(struct pipe_screen *screen, struct pipe_context *ctx, struct pipe_resource *rt,
+               float r, float g, float b, uint32_t *pixel, int64_t *ns)
+{
+   union pipe_color_union color = { .f = { r, g, b, 1.0f } };
+   struct pipe_fence_handle *fence = NULL;
+   int64_t t0 = os_time_get_nano();
+
+   ctx->clear(ctx, PIPE_CLEAR_COLOR0, 0xf, 0, NULL, &color, 0.0, 0);
+   ctx->flush(ctx, &fence, 0);
+   bool done = fence && screen->fence_finish(screen, NULL, fence, OS_TIMEOUT_INFINITE);
+   screen->fence_reference(screen, &fence, NULL);
+   *ns = os_time_get_nano() - t0;
+   if (pixel) {
+      struct pipe_transfer *xfer = NULL;
+      const uint8_t *map = pipe_texture_map(ctx, rt, 0, 0, PIPE_MAP_READ, 0, 0, 256, 256, &xfer);
+      if (!map)
+         return false;
+      memcpy(&pixel[0], map, 4);                                         /* (0, 0) */
+      memcpy(&pixel[1], map + 128 * xfer->stride + 128 * 4, 4);          /* (128, 128) */
+      memcpy(&pixel[2], map + 255 * xfer->stride + 255 * 4, 4);          /* (255, 255) */
+      pipe_texture_unmap(ctx, xfer);
+   }
+   return done;
+}
+
+PUBLIC int
+lapis_gallium_test(lapis_log_fn log)
+{
+   int64_t t0 = os_time_get_nano();
+   struct pipe_screen *screen = lapis_gallium_screen();
+   if (!screen) {
+      say(log, "gallium: no panfrost screen");
+      return 1;
+   }
+   say(log, "gallium: screen in %lld ms: %s / %s / %s", (long long)((os_time_get_nano() - t0) / 1000000),
+       screen->get_name(screen), screen->get_vendor(screen),
+       screen->get_device_vendor ? screen->get_device_vendor(screen) : "-");
+
+   struct pipe_context *ctx = screen->context_create(screen, NULL, 0);
+   if (!ctx) {
+      say(log, "gallium: no context");
+      screen->destroy(screen);
+      return 1;
+   }
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_R8G8B8A8_UNORM,
+      .width0 = 256,
+      .height0 = 256,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_LINEAR,
+      .usage = PIPE_USAGE_DEFAULT,
+   };
+   struct pipe_resource *rt = screen->resource_create(screen, &templ);
+   if (!rt) {
+      say(log, "gallium: no render target");
+      ctx->destroy(ctx);
+      screen->destroy(screen);
+      return 1;
+   }
+   struct pipe_framebuffer_state fb = {
+      .width = 256,
+      .height = 256,
+      .layers = 1,
+      .nr_cbufs = 1,
+   };
+   fb.cbufs[0].format = templ.format;
+   fb.cbufs[0].texture = rt;
+   ctx->set_framebuffer_state(ctx, &fb);
+
+   uint32_t px[3] = { 0, 0, 0 };
+   int64_t ns = 0;
+   bool ok = clear_and_read(screen, ctx, rt, 0.0f, 0.5f, 1.0f, px, &ns);
+   say(log, "gallium: clear on the GPU: fence %s in %lld us; pixels %08x %08x %08x (want ffff8000)",
+       ok ? "done" : "NOT done", (long long)(ns / 1000), px[0], px[1], px[2]);
+
+   ok = clear_and_read(screen, ctx, rt, 1.0f, 0.0f, 0.0f, px, &ns);
+   say(log, "gallium: second clear: fence %s in %lld us; pixels %08x %08x %08x (want ff0000ff)",
+       ok ? "done" : "NOT done", (long long)(ns / 1000), px[0], px[1], px[2]);
+
+   int64_t total = 0;
+   unsigned done = 0;
+   for (unsigned i = 0; i < 100; i++) {
+      done += clear_and_read(screen, ctx, rt, (i & 1) ? 1.0f : 0.0f, 0.25f, 0.75f, NULL, &ns);
+      total += ns;
+   }
+   clear_and_read(screen, ctx, rt, 0.0f, 1.0f, 0.0f, px, &ns);
+   say(log, "gallium: 100 clears: %u fenced, %lld us each; then green: %08x (want ff00ff00)",
+       done, (long long)(total / 100000), px[1]);
+
+   memset(&fb, 0, sizeof(fb));
+   ctx->set_framebuffer_state(ctx, &fb);
+   pipe_resource_reference(&rt, NULL);
+   ctx->destroy(ctx);
+   screen->destroy(screen);
+   say(log, "gallium: done");
+   return 0;
+}
diff -ruN a/src/gallium/targets/lapis/meson.build b/src/gallium/targets/lapis/meson.build
--- a/src/gallium/targets/lapis/meson.build
+++ b/src/gallium/targets/lapis/meson.build
@@ -0,0 +1,20 @@
+# Copyright 2026 the lapis port authors
+# SPDX-License-Identifier: MIT
+#
+# lapis: Mesa's gallium panfrost for programs on iOS, without a GL or Vulkan
+# frontend: one library over the kernel's LapisGPU (src/lapis-drm), with a
+# self-test (lapis_gallium_test) that clears a render target on the GPU and
+# reads it back. tools/lapis_galliumtest calls it on the phone.
+
+liblapis_gallium = shared_library(
+  'lapis_gallium',
+  'lapis_target.c',
+  include_directories : [
+    inc_include, inc_src, inc_util, inc_gallium, inc_gallium_aux,
+    inc_gallium_drivers,
+  ],
+  link_with : [libgallium],
+  dependencies : [driver_panfrost, idep_nir, idep_mesautil, idep_xmlconfig, dep_libdrm],
+  gnu_symbol_visibility : 'hidden',
+  install : true,
+)
