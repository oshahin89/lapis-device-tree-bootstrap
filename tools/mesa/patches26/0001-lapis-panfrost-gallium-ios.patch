+PUBLIC struct lapis_gpu_tex *lapis_gpu_tex_new2(struct lapis_gpu *gpu, unsigned width, unsigned height,
+                                                unsigned format, unsigned levels);
+
+PUBLIC struct lapis_gpu_tex *
+lapis_gpu_tex_new(struct lapis_gpu *gpu, unsigned width, unsigned height, unsigned format)
+{
+   return lapis_gpu_tex_new2(gpu, width, height, format, 1);
+}
+
+PUBLIC struct lapis_gpu_tex *lapis_gpu_tex_new3(struct lapis_gpu *gpu, unsigned width, unsigned height,
+                                                unsigned format, unsigned levels, unsigned mtl_type);
+
+PUBLIC struct lapis_gpu_tex *
+lapis_gpu_tex_new2(struct lapis_gpu *gpu, unsigned width, unsigned height, unsigned format, unsigned levels)
+{
+   return lapis_gpu_tex_new3(gpu, width, height, format, levels, 2);
+}
+
+/* MTLTextureType 0 (1D) or 2 (2D) */
+PUBLIC struct lapis_gpu_tex *
+lapis_gpu_tex_new3(struct lapis_gpu *gpu, unsigned width, unsigned height, unsigned format, unsigned levels,
+                   unsigned mtl_type)
+{
+   unsigned bpp;
+   enum pipe_format pf = mtl_format(format, &bpp);
+   if (!gpu || pf == PIPE_FORMAT_NONE || !width || !height || width > 16384 || height > 16384)
+      return NULL;
+   enum pipe_texture_target target = mtl_type == 0 ? PIPE_TEXTURE_1D : PIPE_TEXTURE_2D;
+   if (mtl_type == 0)
+      height = 1;
+   /* a render target only where panfrost can render to the format */
+   unsigned bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_LINEAR;
+   if (gpu->screen->is_format_supported(gpu->screen, pf, target, 0, 0, PIPE_BIND_RENDER_TARGET))
+      bind |= PIPE_BIND_RENDER_TARGET;
+   struct pipe_resource templ = {
+      .target = target,
+      .format = pf,
+      .width0 = width,
+      .height0 = (uint16_t)height,
+      .depth0 = 1,
+      .array_size = 1,
+      .last_level = (uint8_t)(levels > 1 ? levels - 1 : 0),
+      .bind = bind,
+      .usage = PIPE_USAGE_DEFAULT,
+   };
+   struct lapis_gpu_tex *t = calloc(1, sizeof(*t));
+   pthread_mutex_lock(&gpu->lock);
+   t->res = gpu->screen->resource_create(gpu->screen, &templ);
+   pthread_mutex_unlock(&gpu->lock);
+   if (!t->res) {
+      free(t);
+      return NULL;
+   }
+   t->width = width;
+   t->height = height;
+   t->bpp = bpp;
+   return t;
+}
+
+PUBLIC void
+lapis_gpu_tex_free(struct lapis_gpu *gpu, struct lapis_gpu_tex *tex)
+{
+   if (!tex)
+      return;
+   pthread_mutex_lock(&gpu->lock);
+   pipe_sampler_view_reference(&tex->view, NULL);
+   pipe_resource_reference(&tex->res, NULL);
+   pthread_mutex_unlock(&gpu->lock);
+   free(tex);
+}
