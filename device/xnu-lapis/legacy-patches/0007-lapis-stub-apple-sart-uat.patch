index 0000000..4a790c2
--- /dev/null
+++ b/osfmk/arm64/ppl/uat.h
@@ -0,0 +1,13 @@
+/*
+ * lapis: Apple's UAT (GPU unified address translator) header is not in the
+ * open source drop. This bootstrap hook is a no-op; it does not enable GPU DMA.
+ */
+#ifndef _ARM64_PPL_UAT_H_
+#define _ARM64_PPL_UAT_H_
+
+static inline void
+uat_bootstrap(void)
+{
+}
+
+#endif /* _ARM64_PPL_UAT_H_ */
