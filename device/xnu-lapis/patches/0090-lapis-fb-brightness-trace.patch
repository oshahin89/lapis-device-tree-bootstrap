+/*
+ * lapis: OLED iPhones take brightness on the display service itself
+ * (e.g. IOMFBBrightnessLevel) rather than on a backlight; log every property
+ * userland sets here, with numbers, to find the key and its scale.
+ */
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	static unsigned logs;
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict && logs < 200) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+		if (it) {
+			OSSymbol *key;
+			while ((key = OSDynamicCast(OSSymbol, it->getNextObject())) && logs < 200) {
+				OSObject *o = dict->getObject(key);
+				OSNumber *n = OSDynamicCast(OSNumber, o);
+				logs++;
+				IOLog("LAPIS BR: %s set AppleCLCD %s = %s %#llx\n", name,
+				    key->getCStringNoCopy(),
+				    o ? o->getMetaClass()->getClassName() : "null",
+				    n ? n->unsigned64BitValue() : 0ULL);
+			}
+			it->release();
+		}
+	}
+	return kIOReturnSuccess;
+}
