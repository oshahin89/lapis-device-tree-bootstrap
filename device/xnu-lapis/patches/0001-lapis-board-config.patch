diff --git a/pexpert/pexpert/arm64/LAPIS.h b/pexpert/pexpert/arm64/LAPIS.h
new file mode 100644
index 0000000..613c08f
--- /dev/null
+++ b/pexpert/pexpert/arm64/LAPIS.h
@@ -0,0 +1,62 @@
+/*
+ * Board/CPU configuration for Redmi lapis (MediaTek MT6878).
+ *
+ * This is the initial compile-time profile only. Runtime GIC security state,
+ * PSCI conduit behavior, secondary startup, and the LK handoff are not yet
+ * implemented or verified.
+ */
+
+#ifndef _PEXPERT_ARM64_LAPIS_H
+#define _PEXPERT_ARM64_LAPIS_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define LAPIS                     1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+/* Register offsets consumed by XNU's generic GICv3 FIQ setup. These match
+ * the existing VMAPPLE GICv3 definitions; they provide build-time constants,
+ * not evidence that LAPIS's runtime GIC handoff is correct.
+ */
+#define GICR_PE_SIZE                          0x20000
+#define GICD_CTLR                             0x0
+#define GICD_CTLR_ENABLEGRP0                  0x1
+#define GICR_TYPER                            0x08
+#define GICR_WAKER                            0x14
+#define GICR_IGROUPR0                         0x10080
+#define GICR_ISENABLER0                       0x10100
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT       32
+#define GICR_TYPER_LAST                       0x10
+#define GICR_WAKER_PROCESSORSLEEP             0x2
+#define GICR_WAKER_CHILDRENASLEEP             0x4
+#define ICC_CTLR_EOIMODE                      0x1
+#define ICC_SRE_SRE                           0x1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/* Values derived from lapis runtime FDT. */
+#define LAPIS_GICD_PA             0x0c000000ULL
+#define LAPIS_GICD_SIZE            0x00040000ULL
+#define LAPIS_GICR_PA             0x0c040000ULL
+#define LAPIS_GICR_REGION_SIZE     0x00200000ULL
+#define LAPIS_TIMEBASE_HZ         13000000U
+#define LAPIS_VTIMER_INTID        27U /* DT PPI 11 plus GIC's 16 SGI IDs */
+#define LAPIS_IPI_SGI             1U  /* Candidate only; no IRQ driver uses it yet. */
+
+#define GIC_SPURIOUS_IRQ          1023
+
+#endif /* !_PEXPERT_ARM64_LAPIS_H */
