+
+/*
+ * lapis: the display backlight service backboardd looks for (sweetlog showed
+ * it matching IOPropertyMatch backlight-control = true and finding none).
+ * Brightness is 0..1024 in IODisplayParameters; a set maps it onto the OLED
+ * DCS 0x51 level 16..0xfff (LK boots at 0x639 ~ 400). Every setProperties is
+ * logged so the exact keys backboardd sends can be read from the sweetlog.
+ */
+#define LAPIS_BL_MAX            1024u
+#define LAPIS_BL_DEFAULT        400u
+#define LAPIS_BL_LEVEL_MIN      16u
+#define LAPIS_BL_LEVEL_MAX      0xfffu
+
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+private:
+	unsigned fValue, fLogs;
+	void publishValue(void);
+	bool findValue(OSObject *obj, unsigned depth, unsigned *out);
+	void apply(unsigned value);
+};
+OSDefineMetaClassAndStructors(SweetBacklight, IOService);
+
+void
+SweetBacklight::publishValue(void)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *bright = OSDictionary::withCapacity(3);
+	OSNumber *mn = OSNumber::withNumber(0ULL, 32);
+	OSNumber *mx = OSNumber::withNumber((unsigned long long)LAPIS_BL_MAX, 32);
+	OSNumber *val = OSNumber::withNumber((unsigned long long)fValue, 32);
+	if (params && bright && mn && mx && val) {
+		bright->setObject("min", mn);
+		bright->setObject("max", mx);
+		bright->setObject("value", val);
+		params->setObject("brightness", bright);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(mn);
+	OSSafeReleaseNULL(mx);
+	OSSafeReleaseNULL(val);
+	OSSafeReleaseNULL(bright);
+	OSSafeReleaseNULL(params);
+}
+
+bool
+SweetBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fValue = LAPIS_BL_DEFAULT;
+	setProperty("backlight-control", true);
+	setProperty("AAPL,backlight-control", true);
+	publishValue();
+	registerService();
+	IOLog("LAPIS BACKLIGHT: service up, brightness %u/%u\n", fValue, LAPIS_BL_MAX);
+	return true;
+}
+
+/* First number under a "brightness" / "value" / "rawBrightness" key. */
+bool
+SweetBacklight::findValue(OSObject *obj, unsigned depth, unsigned *out)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, obj);
+	if (!dict || depth > 3) {
+		return false;
+	}
+	static const char *const keys[] = { "value", "brightness", "rawBrightness", "BrightnessValue" };
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+		OSObject *o = dict->getObject(keys[i]);
+		OSNumber *n = OSDynamicCast(OSNumber, o);
+		if (n) {
+			*out = n->unsigned32BitValue();
+			return true;
+		}
+		if (o && findValue(o, depth + 1, out)) {
+			return true;
+		}
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	bool found = false;
+	if (it) {
+		OSSymbol *key;
+		while (!found && (key = OSDynamicCast(OSSymbol, it->getNextObject()))) {
+			found = findValue(dict->getObject(key), depth + 1, out);
+		}
+		it->release();
+	}
+	return found;
+}
+
+void
+SweetBacklight::apply(unsigned value)
+{
+	if (value > LAPIS_BL_MAX) {
+		value = LAPIS_BL_MAX;
+	}
+	fValue = value;
+	unsigned level = LAPIS_BL_LEVEL_MIN +
+	    (unsigned)((unsigned long long)value * (LAPIS_BL_LEVEL_MAX - LAPIS_BL_LEVEL_MIN) / LAPIS_BL_MAX);
+	(void)lapis_brightness_set(level);
+	publishValue();
+}
+
+IOReturn
+SweetBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (fLogs < 40 && dict) {
+		fLogs++;
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+		if (it) {
+			OSSymbol *key;
+			while ((key = OSDynamicCast(OSSymbol, it->getNextObject()))) {
+				OSObject *o = dict->getObject(key);
+				OSNumber *n = OSDynamicCast(OSNumber, o);
+				IOLog("LAPIS BACKLIGHT: set %s = %s %llu\n", key->getCStringNoCopy(),
+				    o ? o->getMetaClass()->getClassName() : "null",
+				    n ? n->unsigned64BitValue() : 0ULL);
+			}
+			it->release();
+		}
+	}
+	unsigned value;
+	if (dict && findValue(dict, 0, &value)) {
+		apply(value);
+		return kIOReturnSuccess;
+	}
+	return kIOReturnUnsupported;
+}
+
+static void
+SweetBacklightCreate(IOService *provider)
+{
+	SweetBacklight *bl = OSTypeAlloc(SweetBacklight);
+	if (!bl || !bl->init()) {
+		OSSafeReleaseNULL(bl);
+		return;
+	}
+	if (!bl->attach(provider) || !bl->start(provider)) {
+		bl->detach(provider);
+		IOLog("LAPIS BACKLIGHT: start failed\n");
+	}
+	bl->release();
+}
