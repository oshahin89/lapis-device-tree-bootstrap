+/* lapis: the fuel gauge's own SOC, current and status. A failed read keeps
+ * the last published reading (or the static fallback before the first). */
+void
+SweetBattery::lapisPoll(void)
+{
+	struct lapis_battery_sample s;
+	if (lapis_battery_read(&s) != 0) {
+		if (!fLapisValid) {
+			publish(100, 4200, 0, true, true, false, true, false, false);
+		}
+		return;
+	}
+	fLapisValid = true;
+	fDesignMah = LAPIS_BATTERY_DESIGN_MAH;
+	fMaxMah = (s.full_mah >= 1000 && s.full_mah <= 20000) ? s.full_mah : LAPIS_BATTERY_DESIGN_MAH;
+	fCycles = s.cycles;
+	fTempC100 = s.temp_c100;
+	bool charging = s.ma > 10;
+	bool external = charging || !(s.status & LAPIS_BQ_STATUS_DSG);
+	bool full = external && ((s.status & LAPIS_BQ_STATUS_FC) || s.percent >= 100);
+	publish(s.percent, s.mv, s.ma, external, external, charging && !full, full, true, true);
+}
